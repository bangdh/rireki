{
	email {$ACME_EMAIL}
	# Certificates for tenant subdomains are issued on first request; the API
	# confirms the subdomain exists before Caddy asks Let's Encrypt.
	on_demand_tls {
		ask http://web:3000/api/internal/tls/ask
	}
}

# Marketing site + tenant sign-up
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# S3 endpoint used by presigned URLs (uploads from browsers, downloads when allowed)
s3.{$DOMAIN} {
	reverse_proxy seaweedfs:8333 {
		header_up Host {http.request.host}
	}
}

# The design mockups, served as static files (compose mounts only index.html, app/, viewer/, public/, assets/)
design.{$DOMAIN} {
	root * /srv/design
	file_server {
		hide .env .git
	}
	encode zstd gzip
}

# Every tenant: saoviet.{$DOMAIN}, yangon-hr.{$DOMAIN}, …
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy web:3000
}
