{
	email {$ACME_EMAIL}
	# Certificates for tenant subdomains are issued on first request; the API
	# confirms the subdomain exists before Caddy asks Let's Encrypt.
	on_demand_tls {
		ask http://api:3000/internal/tls/ask
	}
}

# Marketing site + tenant sign-up
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# S3 endpoint used by presigned URLs (uploads from browsers, downloads when allowed)
s3.{$DOMAIN} {
	reverse_proxy minio:9000 {
		header_up Host {http.request.host}
	}
}

# The design mockups, served as static files from the repository root
design.{$DOMAIN} {
	root * /srv/design
	file_server
	encode zstd gzip
}

# Every tenant: saoviet.{$DOMAIN}, yangon-hr.{$DOMAIN}, …
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	@api path /api/* /internal/* /s/*/stream/*
	reverse_proxy @api api:3000
	reverse_proxy web:3000
}
