{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": [
        "arn:aws:s3:::rireki-originals", "arn:aws:s3:::rireki-media",
        "arn:aws:s3:::rireki-renders", "arn:aws:s3:::rireki-uploads", "arn:aws:s3:::rireki-public"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": [
        "arn:aws:s3:::rireki-originals/*", "arn:aws:s3:::rireki-media/*",
        "arn:aws:s3:::rireki-renders/*", "arn:aws:s3:::rireki-uploads/*", "arn:aws:s3:::rireki-public/*"
      ]
    }
  ]
}
