# Copy to .env and fill in. Nothing here is baked into images.
DOMAIN=rireki.app
ACME_EMAIL=ops@rireki.app
NODE_ENV=production
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_DB=rireki
POSTGRES_USER=rireki
POSTGRES_PASSWORD=change-me-postgres

# S3 identity of the app on SeaweedFS (deploy/seaweedfs/s3.json.tpl); buckets are created by the s3-init service
S3_ACCESS_KEY=rireki-app
S3_SECRET_KEY=change-me-s3-app
S3_REGION=ap-northeast-1

# App secrets
SESSION_SECRET=change-me-64-random-chars
RENDER_SECRET=change-me-32-random-chars   # shared by web (print route) and worker (Playwright)

# Mail (dev: smtp://mailpit:1025 with --profile dev)
SMTP_URL=smtp://user:pass@email-smtp.ap-northeast-1.amazonaws.com:587
MAIL_FROM="Rireki <no-reply@rireki.app>"

# CV extraction (worker only)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
WORKER_CONCURRENCY=2

# Local text/photo extraction (extractor service): Tesseract languages, e.g. jpn+eng+vie+mya+ben+ind
OCR_LANGS=jpn+eng
EXTRACTOR_WORKERS=2
