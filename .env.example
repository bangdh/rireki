# Local development: copy to .env — Docker Compose uses deploy/.env instead.
# Same names as deploy/docker-compose.yml (x-app-env + per-service env); PORT and PLAYWRIGHT_BASE_URL are dev-only.
NODE_ENV=development
APP_DOMAIN=localhost:3000
APP_URL=http://localhost:3000
PORT=3000

DATABASE_URL=postgresql://rireki:rireki@localhost:5432/rireki
REDIS_URL=redis://localhost:6379

# S3: SeaweedFS from deploy/docker-compose.yml (identity in deploy/seaweedfs/s3.json.tpl) or the moto server in the cloud container (ignores credentials)
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=rireki-app
S3_SECRET_KEY=change-me-s3-app
S3_BUCKET_ORIGINALS=rireki-originals
S3_BUCKET_MEDIA=rireki-media
S3_BUCKET_RENDERS=rireki-renders
S3_BUCKET_UPLOADS=rireki-uploads
S3_BUCKET_PUBLIC=rireki-public

# Secrets (dev values; 32+ chars)
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
RENDER_SECRET=dev-render-secret-change-me-0123456789abcdef

# Mail: empty SMTP_URL → nodemailer jsonTransport (messages are logged, not sent)
SMTP_URL=
MAIL_FROM="Rireki <no-reply@localhost>"

# Worker
WORKER_CONCURRENCY=2
WEB_INTERNAL_URL=http://localhost:3000
EXTRACTOR_URL=http://localhost:8000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Extractor
OCR_LANGS=jpn+eng
EXTRACTOR_WORKERS=1

# Playwright (dev-only)
PLAYWRIGHT_BASE_URL=http://saoviet.localhost:3000
